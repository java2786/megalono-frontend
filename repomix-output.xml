<header class="main-header" *ngIf="profile() as data">
  <div class="logo-area">
    {{ data.navigation?.brandName || 'AK' }} <span class="logo-subtitle">{{ data.navigation?.brandSubtitle || '// Systems Consultant' }}</span>
  </div>

  <!-- Desktop Navigation Links -->
  <nav class="desktop-nav">
    <a routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{exact: true}">Overview</a>
    <a routerLink="/cases" routerLinkActive="active">Case Studies</a>
    <a routerLink="/workshops" routerLinkActive="active">Workshops</a>
  </nav>

  <!-- Desktop Theme Switcher Button -->
  <button class="desktop-theme-btn" (click)="toggleTheme()" aria-label="Toggle theme">
    {{ isDark ? '☀️ Light View' : '🌙 Dark View' }}
  </button>

  <!-- Mobile Hamburger Toggle Button -->
  <button class="mobile-hamburger-btn" (click)="toggleMobileMenu()" [attr.aria-expanded]="isMobileMenuOpen()" aria-label="Toggle navigation menu">
    {{ isMobileMenuOpen() ? '✕' : '☰' }}
  </button>

  <!-- Mobile Navigation Drawer Overlay -->
  <div class="mobile-menu-overlay" *ngIf="isMobileMenuOpen()" (click)="closeMobileMenu()">
    <div class="mobile-menu-drawer" (click)="$event.stopPropagation()">
      <nav class="mobile-nav-links">
        <a routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{exact: true}" (click)="closeMobileMenu()">Overview</a>
        <a routerLink="/cases" routerLinkActive="active" (click)="closeMobileMenu()">Case Studies</a>
        <a routerLink="/workshops" routerLinkActive="active" (click)="closeMobileMenu()">Workshops</a>
      </nav>

      <div class="mobile-theme-wrapper">
        <button class="mobile-theme-btn" (click)="toggleTheme()">
          {{ isDark ? '☀️ Light View' : '🌙 Dark View' }}
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Dynamic Content Engine Insertion Point -->
<main class="main-content-wrapper" style="min-height: calc(100vh - 180px);">
  <router-outlet></router-outlet>
</main>

<!-- Unified Profile Network Footer Framework -->
<footer class="main-footer" *ngIf="profile() as data">
  <div class="footer-container">
    <div class="footer-grid">
      
      <!-- Column 1: Consulting Expertise -->
      <div class="footer-col" *ngIf="consultingExpertise().length > 0">
        <h3 class="footer-heading">{{ data.navigation?.consultingTitle || 'Consulting Expertise' }}</h3>
        <ul class="footer-list">
          <li class="footer-list-item" *ngFor="let item of consultingExpertise()">
             {{ item.title }} 
          </li>
        </ul>
      </div>

      <!-- Column 2: Connect -->
      <div class="footer-col" *ngIf="socialLinks().length > 0">
        <h3 class="footer-heading">{{ data.navigation?.socialTitle || 'PROFESSIONAL PROFILES' }}</h3>
        <div class="footer-social-links">
          <a *ngFor="let link of socialLinks()" [href]="link.url" target="_blank" class="footer-social-link">
            {{ link.title }}
          </a>
        </div>
      </div>

      <!-- Column 3: About -->
      <div class="footer-col">
        <h3 class="footer-heading">{{ data.navigation?.aboutTitle || 'About' }}</h3>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <p class="footer-about-brand" *ngIf="data.navigation?.platformName">{{ data.navigation?.platformName }}</p>
          <p class="footer-about-subtitle" *ngIf="data.navigation?.platformSubtitle">{{ data.navigation?.platformSubtitle }}</p>
          <p class="footer-about-details" style="margin-top: 0.5rem;">
            {{ data.navigation?.engineeredBy || ('Designed & Engineered by ' + data.about.name) }}<br>
            {{ data.about.location }}
          </p>
          <p class="footer-about-copyright">© {{ today.getFullYear() }}</p>
        </div>
      </div>

    </div>
